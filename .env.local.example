# Copiază acest fișier în .env.local și completează cu Payment Links reale din Stripe Dashboard.
# Fiecare mărime are propriul link (produsul din Stripe poate fi același, dar creezi
# câte un Payment Link separat per mărime: Stripe Dashboard -> Payment Links -> New).
# Culoarea NU are link separat — se alege la checkout printr-un custom field Stripe (vezi README).
# Sunt link-uri publice (NEXT_PUBLIC_) — nu conțin secrete, doar duc clientul spre checkout Stripe.

NEXT_PUBLIC_STRIPE_LINK_S=https://buy.stripe.com/xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_LINK_M=https://buy.stripe.com/xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_LINK_L=https://buy.stripe.com/xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_LINK_XL=https://buy.stripe.com/xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_LINK_XXL=https://buy.stripe.com/xxxxxxxxxxxx

# --- Notificare furnizor la fiecare comandă plătită (vezi README) ---
# Cheie secretă Stripe (Dashboard -> Developers -> API keys). NU e NEXT_PUBLIC — rămâne pe server.
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
# Semnătura webhook-ului (Dashboard -> Developers -> Webhooks -> [endpoint-ul tău] -> Signing secret).
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# Price ID-ul din spatele fiecărui Payment Link de mai sus (Dashboard -> Products -> [mărime] -> API ID-ul prețului).
STRIPE_PRICE_ID_S=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_M=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_L=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_XL=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_XXL=price_xxxxxxxxxxxx

# Resend (resend.com, cont gratuit) — trimite emailul către furnizor.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Adresă verificată în Resend pe domeniul tău, ex: comenzi@tricouamenda.ro
RESEND_FROM_EMAIL=comenzi@tricouamenda.ro
# Adresa de email a furnizorului care primește specificațiile comenzii (mărime, culoare, bucăți).
PROVIDER_EMAIL=furnizor@example.com
