# Copiază acest fișier în .env.local și completează cu Payment Links reale din Stripe Dashboard.
# Fiecare mărime are propriul link (produsul din Stripe poate fi același, dar creezi
# câte un Payment Link separat per mărime: Stripe Dashboard -> Payment Links -> New).
# Sunt link-uri publice (NEXT_PUBLIC_) — nu conțin secrete, doar duc clientul spre checkout Stripe.

NEXT_PUBLIC_STRIPE_LINK_S=https://buy.stripe.com/xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_LINK_M=https://buy.stripe.com/xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_LINK_L=https://buy.stripe.com/xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_LINK_XL=https://buy.stripe.com/xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_LINK_XXL=https://buy.stripe.com/xxxxxxxxxxxx
