# Copiază acest fișier în .env.local și completează cu valorile reale.
#
# STRUCTURA ÎN STRIPE: un singur produs, cu 10 prețuri (5 mărimi x 2 culori).
# NU ai nevoie de Payment Links — site-ul creează sesiunea de plată direct din
# coș, ca să poți comanda mai multe mărimi într-o singură plată. Setările care
# altfel s-ar bifa pe fiecare link (adresă livrare, adresă facturare, telefon,
# cantitate ajustabilă) sunt în cod, în src/app/api/checkout/route.ts.

# --- Price ID-urile celor 10 variante (server-only) ---
# Le găsești în Stripe Dashboard -> Products -> [produsul tău] -> sub fiecare preț.
# ATENȚIE: price_... (nu prod_...). Sunt singura sursă de adevăr pentru preț:
# clientul trimite doar mărime+culoare, suma o stabilește serverul de aici.
STRIPE_PRICE_ID_S_NEGRU=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_S_ALB=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_M_NEGRU=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_M_ALB=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_L_NEGRU=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_L_ALB=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_XL_NEGRU=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_XL_ALB=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_XXL_NEGRU=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_XXL_ALB=price_xxxxxxxxxxxx

# --- Stripe: cheia secretă și semnătura webhook-ului (server-only) ---
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# --- Resend: emailurile trimise la fiecare comandă plătită ---
RESEND_API_KEY=re_xxxxxxxxxxxx
# Expeditorul emailurilor automate. Adresă de pe domeniul verificat în Resend;
# nu trebuie să existe ca inbox real. Răspunsurile clienților sunt direcționate
# separat, prin replyTo, către adresa de contact reală.
RESEND_FROM_EMAIL=comenzi.no-reply@tricouamenda.ro
# Atelier + magazin. Contact@ și spec-ul de comandă merg la toate adresele, mereu.
# Mai multe inbox-uri: desparte cu virgulă.
PROVIDER_EMAIL=furnizor@example.com
CONTACT_FORWARD_TO=adresa.ta@gmail.com,altcineva@gmail.com

# --- Redirect contact@tricouamenda.ro către inboxul real (Resend receiving) ---
# Signing secret al webhook-ului Resend (Resend -> Webhooks -> endpointul tău -> Signing secret).
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# --- Domeniul public, folosit pentru SEO (canonical, sitemap, date structurate) ---
NEXT_PUBLIC_SITE_URL=https://tricouamenda.ro
