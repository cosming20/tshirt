# Copiază acest fișier în .env.local și completează cu valorile reale.
#
# STRUCTURA ÎN STRIPE: un singur produs, cu 10 prețuri (5 mărimi x 2 culori).
# Fiecare preț are propriul Payment Link. Culoarea e fixată de link, deci
# clientul o alege o singură dată — pe site — și nu mai poate apărea o
# nepotrivire între ce a ales și ce se produce.

# --- Linkurile de plată (publice, duc clientul spre checkout-ul Stripe) ---
NEXT_PUBLIC_STRIPE_LINK_S_NEGRU=https://buy.stripe.com/xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_LINK_S_ALB=https://buy.stripe.com/xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_LINK_M_NEGRU=https://buy.stripe.com/xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_LINK_M_ALB=https://buy.stripe.com/xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_LINK_L_NEGRU=https://buy.stripe.com/xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_LINK_L_ALB=https://buy.stripe.com/xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_LINK_XL_NEGRU=https://buy.stripe.com/xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_LINK_XL_ALB=https://buy.stripe.com/xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_LINK_XXL_NEGRU=https://buy.stripe.com/xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_LINK_XXL_ALB=https://buy.stripe.com/xxxxxxxxxxxx

# --- Price ID-urile din spatele fiecărui link (server-only) ---
# Le găsești în Stripe Dashboard -> Products -> [produsul tău] -> sub fiecare preț.
# ATENȚIE: price_... (nu prod_...). Webhook-ul le folosește ca să știe ce variantă s-a vândut.
STRIPE_PRICE_ID_S_NEGRU=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_S_ALB=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_M_NEGRU=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_M_ALB=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_L_NEGRU=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_L_ALB=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_XL_NEGRU=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_XL_ALB=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_XXL_NEGRU=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_XXL_ALB=price_xxxxxxxxxxxx

# --- Stripe: cheia secretă și semnătura webhook-ului (server-only) ---
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# --- Resend: emailurile trimise la fiecare comandă plătită ---
RESEND_API_KEY=re_xxxxxxxxxxxx
# Adresă de pe domeniul verificat în Resend (nu trebuie să existe ca inbox real).
RESEND_FROM_EMAIL=comenzi@tricouamenda.ro
# Producătorul care primește specificațiile de fabricație (mărime, culoare, bucăți).
PROVIDER_EMAIL=furnizor@example.com

# --- Redirect contact@tricouamenda.ro către inboxul real (Resend receiving) ---
# Signing secret al webhook-ului Resend (Resend -> Webhooks -> endpointul tău -> Signing secret).
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# Adresa reală unde ajung mesajele trimise pe contact@tricouamenda.ro.
CONTACT_FORWARD_TO=adresa.ta@gmail.com

# --- Domeniul public, folosit pentru SEO (canonical, sitemap, date structurate) ---
NEXT_PUBLIC_SITE_URL=https://tricouamenda.ro
